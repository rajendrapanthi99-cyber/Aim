local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local CONFIG = {
	Enabled = true,
	ToggleKey = Enum.KeyCode.K,
	MaxDistance = 150,         -- studs
	FOVRadius = 200,           -- pixels from screen center
	Smoothness = 0.15,         -- 0.05 = subtle, 1 = instant snap
	TargetPart = "Head",       -- try "HumanoidRootPart" for melee/fruit moves
	TeamCheck = true,          -- players only
	WallCheck = true,
	LinesNeedVisible = false,
	LineThickness = 2,

	-- What triggers aim assist
	AimOnRightMouse = true,
	AimOnToolUse = true,       -- click/tap while a Tool is equipped
	AimOnAbilityKeys = true,
	AbilityKeys = {
		Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C,
		Enum.KeyCode.V, Enum.KeyCode.F,
	},
	AbilityAimTime = 0.6,      -- seconds assist stays active after a key press
	ToolAimTime = 0.25,        -- seconds assist stays active after a click

	-- Projectile lead (0 = off). Set to your projectile's speed in studs/sec.
	ProjectileSpeed = 0,
}

local rightMouseHeld = false
local aimUntil = 0

-- Shared target for your move scripts to read
local aimTargetValue = Instance.new("ObjectValue")
aimTargetValue.Name = "AimTarget"
aimTargetValue.Parent = player

local function isAiming()
	return rightMouseHeld or os.clock() < aimUntil
end

-- UI
local gui = Instance.new("ScreenGui")
gui.Name = "AimAssistUI"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local circle = Instance.new("Frame")
circle.AnchorPoint = Vector2.new(0.5, 0.5)
circle.Position = UDim2.fromScale(0.5, 0.5)
circle.Size = UDim2.fromOffset(CONFIG.FOVRadius * 2, CONFIG.FOVRadius * 2)
circle.BackgroundTransparency = 1
circle.Parent = gui
Instance.new("UICorner", circle).CornerRadius = UDim.new(1, 0)

local stroke = Instance.new("UIStroke", circle)
stroke.Color = Color3.new(1, 1, 1)
stroke.Thickness = 1.5
stroke.Transparency = 0.5

local toggleBtn = Instance.new("TextButton")
toggleBtn.Name = "ToggleButton"
toggleBtn.Size = UDim2.fromOffset(130, 36)
toggleBtn.Position = UDim2.fromOffset(12, 60)
toggleBtn.Font = Enum.Font.GothamBold
toggleBtn.TextSize = 14
toggleBtn.TextColor3 = Color3.new(1, 1, 1)
toggleBtn.Parent = gui
Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0, 8)

local function refreshButton()
	if CONFIG.Enabled then
		toggleBtn.Text = "Aim Assist: ON"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(40, 160, 70)
	else
		toggleBtn.Text = "Aim Assist: OFF"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(190, 50, 50)
	end
	circle.Visible = CONFIG.Enabled
end

local function setEnabled(value)
	CONFIG.Enabled = value
	if not value then
		rightMouseHeld = false
		aimUntil = 0
		aimTargetValue.Value = nil
		player:SetAttribute("AimPosition", nil)
	end
	refreshButton()
end

toggleBtn.Activated:Connect(function()
	setEnabled(not CONFIG.Enabled)
end)
refreshButton()

-- Input
local abilityKeySet = {}
for _, k in ipairs(CONFIG.AbilityKeys) do abilityKeySet[k] = true end

local function hasToolEquipped()
	local char = player.Character
	return char and char:FindFirstChildOfClass("Tool") ~= nil
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end

	if input.KeyCode == CONFIG.ToggleKey then
		setEnabled(not CONFIG.Enabled)
		return
	end
	if not CONFIG.Enabled then return end

	if input.UserInputType == Enum.UserInputType.MouseButton2 and CONFIG.AimOnRightMouse then
		rightMouseHeld = true

	elseif CONFIG.AimOnAbilityKeys and abilityKeySet[input.KeyCode] then
		aimUntil = math.max(aimUntil, os.clock() + CONFIG.AbilityAimTime)

	elseif CONFIG.AimOnToolUse
		and (input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch)
		and hasToolEquipped() then
		aimUntil = math.max(aimUntil, os.clock() + CONFIG.ToolAimTime)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		rightMouseHeld = false
	end
end)

-- Visibility
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function isVisible(part)
	rayParams.FilterDescendantsInstances = { player.Character, part.Parent }
	local origin = camera.CFrame.Position
	return workspace:Raycast(origin, part.Position - origin, rayParams) == nil
end

-- Candidates: players + NPCs
local function getCandidates()
	local list, seen = {}, {}
	local function add(model)
		if model and not seen[model] then
			seen[model] = true
			table.insert(list, model)
		end
	end

	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player and not (CONFIG.TeamCheck and other.Team == player.Team) then
			add(other.Character)
		end
	end
	for _, npc in ipairs(CollectionService:GetTagged("NPC")) do
		add(npc)
	end
	local folder = workspace:FindFirstChild("NPCs")
	if folder then
		for _, npc in ipairs(folder:GetChildren()) do
			if npc:IsA("Model") then add(npc) end
		end
	end
	return list
end

local function evaluate(model, center)
	local part = model:FindFirstChild(CONFIG.TargetPart)
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not (part and hum and hum.Health > 0) then return end

	local pos, onScreen = camera:WorldToViewportPoint(part.Position)
	if not onScreen or pos.Z > CONFIG.MaxDistance then return end

	local delta = Vector2.new(pos.X, pos.Y) - center
	if delta.Magnitude > CONFIG.FOVRadius then return end
	return part, delta
end

local function getTarget()
	local center = camera.ViewportSize / 2
	local best, bestDist = nil, math.huge
	for _, model in ipairs(getCandidates()) do
		local part, delta = evaluate(model, center)
		if part and delta.Magnitude < bestDist then
			if not CONFIG.WallCheck or isVisible(part) then
				best, bestDist = part, delta.Magnitude
			end
		end
	end
	return best
end

local function getAimPosition(part)
	local pos = part.Position
	if CONFIG.ProjectileSpeed > 0 then
		local dist = (pos - camera.CFrame.Position).Magnitude
		pos += part.AssemblyLinearVelocity * (dist / CONFIG.ProjectileSpeed)
	end
	return pos
end

-- Red lines
local lines = {}
local function getLine(i)
	if not lines[i] then
		local f = Instance.new("Frame")
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
		f.BorderSizePixel = 0
		f.Parent = gui
		lines[i] = f
	end
	return lines[i]
end

-- Main loop
RunService.RenderStepped:Connect(function()
	circle.Size = UDim2.fromOffset(CONFIG.FOVRadius * 2, CONFIG.FOVRadius * 2)

	local center = camera.ViewportSize / 2
	local used = 0

	if CONFIG.Enabled then
		for _, model in ipairs(getCandidates()) do
			local part, delta = evaluate(model, center)
			if part and (not CONFIG.LinesNeedVisible or isVisible(part)) then
				used += 1
				local line = getLine(used)
				line.Size = UDim2.fromOffset(delta.Magnitude, CONFIG.LineThickness)
				line.Position = UDim2.fromOffset(center.X + delta.X / 2, center.Y + delta.Y / 2)
				line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
				line.Visible = true
			end
		end

		if isAiming() then
			local target = getTarget()
			aimTargetValue.Value = target
			if target then
				local aimPos = getAimPosition(target)
				player:SetAttribute("AimPosition", aimPos)
				local goal = CFrame.lookAt(camera.CFrame.Position, aimPos)
				camera.CFrame = camera.CFrame:Lerp(goal, CONFIG.Smoothness)
			else
				player:SetAttribute("AimPosition", nil)
			end
		else
			aimTargetValue.Value = nil
			player:SetAttribute("AimPosition", nil)
		end
	end

	for i = used + 1, #lines do
		lines[i].Visible = false
	end
end)
